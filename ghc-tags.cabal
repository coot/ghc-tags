cabal-version:       3.0
name:                ghc-tags
version:             2.0
synopsis:            Utility for generating ctags and etags with GHC API.
description:         Utility for generating etags (Emacs) and ctags (Vim and other
                     editors) with GHC API for efficient project navigation.
license:             MPL-2.0
license-file:        LICENSE
author:              Andrzej Rybczak
maintainer:          Marcin Szamotulski coot@coot.me
copyright:           (c) 2021-2023, Andrzej Rybczak,
                     (c) 2023-2026, Marcin Szamotulski
category:            Development
extra-source-files:  CHANGELOG.md
                     README.md
homepage:            https://github.com/coot/ghc-tags
bug-reports:         https://github.com/coot/ghc-tags/issues
tested-with:         GHC == { 9.6, 9.8, 9.10, 9.12, 9.14 }

source-repository head
  type:     git
  location: https://github.com/arybczak/ghc-tags

executable ghc-tags
  ghc-options:         -Wall -threaded -rtsopts -with-rtsopts=-A4m

  build-depends:       base >=4.14 && <4.22
                     , aeson >= 2.0.0.0
                     , async
                     , attoparsec
                     , bytestring
                     , containers
                     , deepseq
                     , directory
                     , filepath
                     , ghc >= 9.2
                     , ghc-boot
                     , ghc-paths
                     , ghc-tags-core:ghc-tags-core ^>= 0.6.2
                     , stm
                     , optparse-applicative
                     , process
                     , temporary
                     , text
                     , time
                     , vector
                     , yaml

  hs-source-dirs:      src

  main-is:             Main.hs

  other-modules:       GhcTags
                       GhcTags.Config.Args
                       GhcTags.Config.Project
                       GhcTags.GhcCompat
                       Paths_ghc_tags

  autogen-modules:     Paths_ghc_tags
  cpp-options: -DMIN_VERSION_GHC(x,y)=MIN_VERSION_GLASGOW_HASKELL(x,y,0,0)

  default-language:    Haskell2010
  default-extensions:  BangPatterns
                     , DataKinds
                     , FlexibleContexts
                     , FlexibleInstances
                     , GADTs
                     , KindSignatures
                     , LambdaCase
                     , MultiWayIf
                     , NamedFieldPuns
                     , OverloadedStrings
                     , RecordWildCards
                     , ScopedTypeVariables
                     , StrictData
                     , StandaloneDeriving
                     , TupleSections
